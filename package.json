{
  "name": "bloodcraft-launcher",
  "version": "0.1.9",
  "private": true,
  "main": "dist-electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && electron .\"",
    "icons:generate": "node scripts/generate-icons.mjs && icon-gen -i build/icon.png -o build --icns --report",
    "build": "tsc -b && vite build && tsc -p electron/tsconfig.json && tsc -p electron/tsconfig.preload.json",
    "pack": "npm run build && electron-builder --dir",
    "dist:mac": "npm run icons:generate && npm run build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --publish never",
    "dist:win": "npm run icons:generate && npm run build && electron-builder --win nsis --publish never",
    "preview": "vite preview",
    "lint": "eslint ."
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.8.3",
    "extract-zip": "^2.0.1",
    "framer-motion": "^11.11.9",
    "minecraft-launcher-core": "^3.18.2",
    "keytar": "^7.9.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.34.5",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/node": "^22.8.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.0.1",
    "electron": "^32.2.1",
    "electron-builder": "^26.8.1",
    "eslint": "^9.13.0",
    "icon-gen": "^5.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "ru.thebloodcraft.launcher",
    "productName": "BloodCraft",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "electron/**",
      "build/**",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "BloodForg",
        "repo": "BloodCraft_launcher",
        "releaseType": "release"
      }
    ],
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/app.icns",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": null
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "artifactName": "BloodCraft.exe"
    }
  }
}
